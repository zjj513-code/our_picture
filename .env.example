AWS_REGION=ap-northeast-1
AWS_ORIGINALS_BUCKET=our-pictures-dev-066899195278-originals
AWS_WEB_BUCKET=our-pictures-dev-066899195278-web
AWS_CLOUDFRONT_DISTRIBUTION_ID=E27LBWNJWHPBCQ
PHOTO_CDN_BASE_URL=https://d1v1mg445zdh54.cloudfront.net
AWS_UPLOAD_URL_TTL_SECONDS=900

# Optional non-interactive values for `npm run admin:create`.
# Never commit real values in .env.local.
ADMIN_USERNAME=
ADMIN_PASSWORD=
