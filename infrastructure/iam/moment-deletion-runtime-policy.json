{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeleteOnlyManagedMomentObjects",
      "Effect": "Allow",
      "Action": "s3:DeleteObject",
      "Resource": [
        "arn:aws:s3:::our-pictures-dev-066899195278-originals/originals/moments/*/photos/*/source.*",
        "arn:aws:s3:::our-pictures-dev-066899195278-originals/processing-results/*.json",
        "arn:aws:s3:::our-pictures-dev-066899195278-web/moments/*/photos/*/display.webp",
        "arn:aws:s3:::our-pictures-dev-066899195278-web/moments/*/photos/*/thumbnail.webp"
      ]
    },
    {
      "Sid": "ClearOnlyTheDevelopmentDistributionCache",
      "Effect": "Allow",
      "Action": [
        "cloudfront:CreateInvalidation",
        "cloudfront:GetInvalidation"
      ],
      "Resource": "arn:aws:cloudfront::066899195278:distribution/E27LBWNJWHPBCQ"
    }
  ]
}
