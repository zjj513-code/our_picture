{
  "LambdaFunctionConfigurations": [
    {
      "Id": "ProcessOurPicturesOriginals",
      "LambdaFunctionArn": "arn:aws:lambda:ap-northeast-1:066899195278:function:our-pictures-dev-image-processor",
      "Events": [
        "s3:ObjectCreated:*"
      ],
      "Filter": {
        "Key": {
          "FilterRules": [
            {
              "Name": "prefix",
              "Value": "originals/"
            }
          ]
        }
      }
    }
  ]
}
